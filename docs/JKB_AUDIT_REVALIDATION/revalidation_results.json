      "testId": "INT-01",
      "name": "Mobile Navigation Drawer Open & Scroll",
      "route": "/",
      "viewport": "390x844",
      "beforeShot": "reval_01_mobile_nav_drawer_before.png",
      "afterShot": "reval_01_mobile_nav_drawer_open_after.png",
      "scrolledShot": "reval_01_mobile_nav_drawer_scrolled_after.png",
      "expected": "Hamburger button toggles open full-screen/sliding drawer with all primary and secondary navigation links visible.",
      "actual": "Drawer visibly mounted, mobile links displayed.",
      "stateChanged": true,
      "verdict": "PASS",
      "notes": "Previous audit used invalid selector button[aria-label=\"Buka menu navigasi\"] producing identical hash to closed homepage."
    },
    {
      "testId": "INT-02",
      "name": "Schedule Date Switching & Item Expansion",
      "route": "/jadwal",
      "viewport": "1440x900",
      "beforeShot": "reval_02_schedule_day1_before.png",
      "afterShot": "reval_02_schedule_item_expanded_after.png",
      "expected": "Clicking 13 DES / 14 DES updates timeline. Clicking \"Lihat Detail\" toggles button to \"Tutup Detail\" and displays description text.",
      "actual": "Day switching works. Expand toggle succeeded (hasCloseBtn=true, hasDesc=true).",
      "stateChanged": true,
      "verdict": "PASS",
      "notes": "Day 3 displays incorrect weekday (\"Minggu, 14 Desember 2026\" instead of \"Senin, 14 Desember 2026\")."
    },
    {
      "testId": "INT-03",
      "name": "Fighter Search & Empty Results Filter",
      "route": "/fighters",
      "viewport": "1440x900",
      "beforeShot": "reval_03_fighters_search_before.png",
      "afterShot": "reval_03_fighters_empty_results_after.png",
